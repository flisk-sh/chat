{
  "name": "flisk-chat",
  "description": "Ask for a task or a website, plan it with an AI model, and run it with a computer.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/chat.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test test && node --test scripts/*.test.mjs evals/answers/*.test.mjs",
    "eval": "node evals/answers/run.mjs",
    "test:mobile": "node scripts/mobile-qa.mjs https://chat.flisk.si/",
    "eval:loop": "node evals/answers/loop.mjs",
    "check:radius": "node scripts/check-radius.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "msedge-tts": "2.1.1"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
